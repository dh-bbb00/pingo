generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ==================== Auth ====================

/// 서비스 사용자. 관리자 승인 후 로그인 가능.
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String     // bcrypt 해시
  role      Role       @default(USER)
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  devices          Device[]
  approvalRequests ApprovalRequest[] @relation("UserApprovals")
  reviewedRequests ApprovalRequest[] @relation("ReviewedBy")
  categories       Category[]
  transactions     Transaction[]
  fixedExpenses    FixedExpense[]
  refreshTokens    RefreshToken[]
  paymentMethods   PaymentMethod[]
}

enum Role {
  USER  // 일반 사용자
  ADMIN // 승인 관리 권한
}

enum UserStatus {
  PENDING   // 승인 대기
  APPROVED  // 승인 완료, 로그인 가능
  REJECTED  // 거절
  SUSPENDED // 관리자 사용 정지
}

/// 사용자의 기기 정보. isTrusted 기기만 로그인 허용. deviceUid 변경 감지 시 재승인 필요.
model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceUid  String   // react-native-device-info getUniqueId(). 앱 재설치·초기화 시 변경될 수 있음
  deviceName String   // getDeviceName()  예: "홍길동의 iPhone"
  phoneModel String   // getModel()       예: "SM-S921N"
  osVersion  String   // getSystemVersion() 예: "Android 15"
  appVersion String   // getVersion()     예: "1.0.0"
  isTrusted  Boolean  @default(false) // 관리자 승인 완료 후 true. deviceUid 변경 감지 시 false로 초기화
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  approvalRequests ApprovalRequest[]
  refreshTokens    RefreshToken[]

  @@unique([userId, deviceUid])
  @@index([deviceUid])
}

/// 사용 승인 요청 내역. 관리자가 승인·거절하며 처리자와 처리 시각을 기록.
model ApprovalRequest {
  id           String         @id @default(cuid())
  userId       String
  deviceId     String
  type         RequestType    @default(NEW_USER)
  status       ApprovalStatus @default(PENDING)
  reviewedById String?        // 승인·거절한 관리자 ID
  reviewedAt   DateTime?      // 승인·거절 처리 시각
  createdAt    DateTime       @default(now())

  user       User    @relation("UserApprovals", fields: [userId], references: [id])
  device     Device  @relation(fields: [deviceId], references: [id])
  reviewedBy User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
}

enum ApprovalStatus {
  PENDING  // 대기
  APPROVED // 승인
  REJECTED // 거절
}

enum RequestType {
  NEW_USER    // 신규 가입 승인 요청
  NEW_DEVICE  // 기존 승인 유저의 새 기기 추가 요청
}

/// 승인요청 rate limit. IP + deviceUid 기준 10분간 3회 초과 시 차단.
model ApprovalRateLimit {
  id             String   @id @default(cuid())
  ip             String
  deviceUid      String
  requestCount   Int      @default(1)
  firstRequestAt DateTime @default(now()) // 윈도우 시작 시각. 현재 시각 - firstRequestAt > 10분이면 초기화

  @@unique([ip, deviceUid])
  @@index([firstRequestAt])
}

/// JWT refresh token. 기기별로 발급·관리하며 로그아웃 시 삭제.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String
  token     String   @unique // 해시 저장 권장
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([userId])
}

// ==================== Finance ====================

/// 사용자가 직접 등록·관리하는 소비 카테고리.
model Category {
  id             String   @id @default(cuid())
  userId         String
  name           String
  icon           String?  // 아이콘 식별자
  color          String?  // HEX 색상코드 예: "#FF5733"
  isBudgetFixed  Boolean  @default(false) // true면 매월 동일 예산 자동 적용
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id])
  transactions   Transaction[]
  fixedExpenses  FixedExpense[]
  monthlyBudgets CategoryMonthlyBudget[]

  @@unique([userId, name])
}

/// 카테고리 월별 예산 스냅샷. 이번 달 예산 수정 시 upsert, isBudgetFixed=true면 스케줄러가 매월 1일 전월 값 복사.
model CategoryMonthlyBudget {
  id         String   @id @default(cuid())
  categoryId String
  year       Int
  month      Int      // 1–12
  budget     Int      // 원 단위
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, year, month])
  @@index([categoryId])
}

enum PaymentMethodType {
  CASH       // 현금
  GIFT_CARD  // 상품권
  CARD       // 카드 (사용자 등록)
}

/// 결제수단. CASH·GIFT_CARD는 유저 승인 시 자동 생성, CARD는 사용자가 직접 등록.
model PaymentMethod {
  id        String            @id @default(cuid())
  userId    String
  type      PaymentMethodType
  name       String            // CARD: 카드사명, CASH: "현금", GIFT_CARD: "상품권"
  cardNumber String?           // CARD 전용 카드번호 (예: 끝 4자리). CASH·GIFT_CARD는 null
  isDefault  Boolean           @default(false) // 기본 결제수단 여부 (내정보 화면에서 관리)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  fixedExpenses FixedExpense[]

  @@index([userId])
  @@map("payment_methods")
}

/// 소비 내역. 수동 입력 및 고정 지출·할부 자동 생성분 포함.
model Transaction {
  id              String   @id @default(cuid())
  userId          String
  categoryId      String?       // null = 기타 (카테고리 삭제 시 자동 SetNull)
  paymentMethodId String?       // null = 결제수단 미지정 (결제수단 삭제 시 자동 SetNull)
  amount          Int           // 원 단위. 할부인 경우 월 납입금
  merchantName    String        // 가맹점명
  memo            String?
  transactionDate DateTime      // 실제 거래 일시 (createdAt과 다를 수 있음)
  // 할부 필드 — installmentMonths가 null이면 일시불
  installmentMonths     Int?      // 할부 개월수 (2 이상). null = 일시불
  totalAmount           Int?      // 할부 원금. null = 일시불
  installmentEndDate    DateTime? // 마지막 납부월. 스케줄러가 이 월까지 매월 생성
  originalTransactionId String?   // 원거래 FK. 스케줄러 생성 할부 내역에 설정. null = 원거래 or 일시불
  fixedExpenseId        String?   // 고정지출 자동 생성 시 설정. null = 수동 등록 or 할부 자식
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user                User           @relation(fields: [userId], references: [id])
  category            Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethod       PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  originalTransaction Transaction?   @relation("InstallmentChain", fields: [originalTransactionId], references: [id], onDelete: SetNull)
  installmentChildren Transaction[]  @relation("InstallmentChain")
  fixedExpense        FixedExpense?  @relation("FixedExpenseTransactions", fields: [fixedExpenseId], references: [id], onDelete: SetNull)

  @@index([userId, transactionDate])  // 날짜 기준 조회·통계 쿼리 최적화
  @@index([originalTransactionId])    // 할부 자식 내역 조회 최적화
  @@index([fixedExpenseId])           // 고정지출별 내역 조회 최적화
}


// ==================== Scheduler ====================

enum SchedulerLogType {
  BUDGET_ROLLOVER // 예산 이월
  FIXED_EXPENSES  // 고정 지출 자동 생성
  INSTALLMENTS    // 할부 납입 내역 자동 생성
}

enum SchedulerTrigger {
  CRON   // 자동 실행 (cron)
  MANUAL // 수동 실행 (어드민 API)
}

enum SchedulerLogStatus {
  NOT_RUN // 미실행 (다음달 예약 항목)
  SUCCESS // 성공
  FAILURE // 실패
}

/// 스케줄러 실행 로그. 매월 자동/수동 실행 결과를 기록.
/// NOT_RUN: 스케줄러 정상 실행 후 다음달을 위해 미리 생성되는 예약 항목.
model SchedulerLog {
  id           String              @id @default(cuid())
  type         SchedulerLogType
  year         Int
  month        Int                 // 1-12
  status       SchedulerLogStatus  @default(NOT_RUN)
  runAt        DateTime?           // NOT_RUN 상태에서는 null
  totalCount   Int?                // 처리 대상 전체 건수 (실행 후 기록)
  successCount Int?                // 실제 생성된 건수 (실행 후 기록)
  error        String?             // 실패 시 에러 메시지
  triggeredBy  SchedulerTrigger?   // NOT_RUN 상태에서는 null

  @@index([type, year, month])
  @@index([year, month])
  @@index([status])
}

/// 고정 지출 항목. 스케줄러가 매월 1일에 실행되어 isActive 항목의 Transaction을 생성.
/// Transaction의 transactionDate는 해당 월의 dayOfMonth일로 설정됨.
model FixedExpense {
  id              String   @id @default(cuid())
  userId          String
  categoryId      String
  paymentMethodId String?
  amount          Int      // 원 단위
  merchantName    String   // 가맹점명
  memo            String?
  dayOfMonth      Int      // Transaction에 기록될 지출 날짜 (1~31). 해당 월에 없는 날짜면 말일로 처리
  isActive        Boolean  @default(true) // false면 스케줄러 실행 시 제외
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  transactions  Transaction[]  @relation("FixedExpenseTransactions")
}
