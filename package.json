{
  "name": "pingo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "infra:up-dev": "docker compose up",
    "infra:up": "docker compose -f docker-compose.yml up -d",
    "infra:down": "docker compose down",
    "infra:build": "docker compose build",
    "infra:logs": "docker compose logs -f",
    "infra:restart": "docker compose restart",
    "db:reset": "pnpm --filter @pingo/api exec prisma migrate reset --force",
    "db:migrate": "pnpm --filter @pingo/api prisma:migrate",
    "db:generate": "pnpm --filter @pingo/api prisma:generate",
    "db:seed": "pnpm --filter @pingo/api prisma:seed",
    "app:start": "pnpm --filter @pingo/app start",
    "app:android": "pnpm --filter @pingo/app android",
    "app:apk:debug": "pnpm --filter @pingo/app apk:debug",
    "app:apk:release": "pnpm --filter @pingo/app apk:release",
    "adb:reset": "adb kill-server && adb start-server"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
